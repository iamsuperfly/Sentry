    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "grammy": "^1.45.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "viem": "^2.55.19",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
