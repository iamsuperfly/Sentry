# Supabase server-side access. Never commit real values.
PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-secret

# Telegram BotFather token. Keep this in Replit Secrets.
TELEGRAM_BOT_TOKEN=replace-with-a-secret

# Treasury wallet used to sponsor new user wallets. Keep this in Replit Secrets.
TREASURY_PRIVATE_KEY=replace-with-a-secret

# 32-byte hex or base64 key used to encrypt user wallet private keys.
WALLET_ENCRYPTION_KEY=replace-with-a-secret

# Somnia Shannon testnet only.
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
INITIAL_GAS_SPONSOR_AMOUNT=0.1
INITIAL_TUSDC_FAUCET_AMOUNT=20
EXPLORER_TX_BASE_URL=https://shannon-explorer.somnia.network/tx